<Window
    x:Class="TidalManager.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:views="using:TidalManager.App.Views"
    Title="Tidal Manager">
    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>
    <Grid x:Name="RootGrid" Background="Transparent">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Frame x:Name="ContentFrame">
            <Frame.ContentTransitions>
                <TransitionCollection>
                    <NavigationThemeTransition>
                        <NavigationThemeTransition.DefaultNavigationTransitionInfo>
                            <EntranceNavigationTransitionInfo />
                        </NavigationThemeTransition.DefaultNavigationTransitionInfo>
                    </NavigationThemeTransition>
                </TransitionCollection>
            </Frame.ContentTransitions>
        </Frame>

        <!-- Lets the window be dragged by its top edge; page headers start below it. -->
        <Grid x:Name="DragRegion" Height="32" VerticalAlignment="Top" Background="Transparent" />

        <!-- Bottom app bar: progress, status, and the one sync button. -->
        <Grid Grid.Row="1" Background="{StaticResource MetroAppBarBrush}">
            <Grid.RowDefinitions>
                <RowDefinition Height="4" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Grid x:Name="ProgressTrack" Background="{ThemeResource ControlFillColorSecondaryBrush}" SizeChanged="ProgressTrack_SizeChanged">
                <Rectangle x:Name="ProgressFill" Fill="{StaticResource MetroAccentBrush}" HorizontalAlignment="Left" Width="0" />
            </Grid>
            <Grid Grid.Row="1" Padding="120,0,24,0" ColumnSpacing="24">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center" Spacing="2">
                    <TextBlock x:Name="StatusText" Style="{StaticResource MetroBodyStyle}" FontSize="20" FontWeight="Light"
                               TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" />
                    <TextBlock x:Name="DetailText" Style="{StaticResource MetroBodyStyle}" FontSize="13"
                               Foreground="{StaticResource MetroDimTextBrush}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" />
                </StackPanel>
                <Button x:Name="SyncButton" Grid.Column="1" Style="{StaticResource MetroAppBarButtonStyle}"
                        Content="sync" Tag="&#xE895;" Click="Sync_Click" AutomationProperties.Name="Sync" />
            </Grid>
        </Grid>

        <!-- Settings slide in from the right edge, light themed, like the 8.1 settings flyout. -->
        <Popup x:Name="SettingsPopup" IsLightDismissEnabled="True" Closed="SettingsPopup_Closed">
            <Popup.ChildTransitions>
                <TransitionCollection>
                    <PaneThemeTransition Edge="Right" />
                </TransitionCollection>
            </Popup.ChildTransitions>
            <views:SettingsPane x:Name="Settings" Width="346" BackRequested="Settings_BackRequested" />
        </Popup>
    </Grid>
</Window>
