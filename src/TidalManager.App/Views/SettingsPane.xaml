<UserControl
    x:Class="TidalManager.App.Views.SettingsPane"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
          BorderBrush="{StaticResource MetroAccentBrush}" BorderThickness="2,0,0,0">
        <Grid.RowDefinitions>
            <RowDefinition Height="80" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" Padding="16,32,24,0" ColumnSpacing="6">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Button Style="{StaticResource MetroBackButtonStyle}" Width="40" Padding="0" Click="Back_Click"
                    RenderTransformOrigin="0.5,0.5" VerticalAlignment="Top" Margin="0,-12,0,0">
                <Button.RenderTransform>
                    <ScaleTransform ScaleX="0.75" ScaleY="0.75" />
                </Button.RenderTransform>
            </Button>
            <TextBlock Grid.Column="1" Text="settings" FontFamily="{StaticResource MetroFont}" FontWeight="SemiLight"
                       FontSize="26.667" VerticalAlignment="Top" Margin="0,-6,0,0" />
        </Grid>
        <ScrollViewer Grid.Row="1">
            <StackPanel Padding="40,8,40,40" Spacing="12">
                <TextBlock Text="account" Style="{StaticResource MetroSubheaderStyle}" />
                <TextBlock x:Name="AccountText" Style="{StaticResource MetroBodyStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                <TextBox x:Name="ClientIdBox" Header="TIDAL client ID" PlaceholderText="from developer.tidal.com" />
                <TextBox x:Name="RedirectBox" Header="Redirect URI" Text="http://127.0.0.1:8888/callback/" />
                <Button x:Name="SignInButton" Content="sign in" Click="SignIn_Click" HorizontalAlignment="Left" />
                <StackPanel x:Name="PastePanel" Visibility="Collapsed" Spacing="8">
                    <TextBox x:Name="CallbackBox" Header="If the browser didn't return here, paste its address" />
                    <Button Content="finish sign in" Click="FinishSignIn_Click" HorizontalAlignment="Left" />
                </StackPanel>

                <TextBlock Text="downloads" Style="{StaticResource MetroSubheaderStyle}" />
                <TextBlock Style="{StaticResource MetroBodyStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                           Text="Tracks are downloaded by a separately installed tiddl command. Its sign-in is separate from this app." />
                <TextBox x:Name="ToolBox" Header="tiddl command" PlaceholderText="tiddl" TextChanged="ToolBox_TextChanged" />
                <TextBlock x:Name="TiddlStatus" Style="{StaticResource MetroBodyStyle}" FontSize="13"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                <TextBox x:Name="OutputBox" Header="Download folder" />
                <Button Content="browse" Click="BrowseOutput_Click" HorizontalAlignment="Left" />

                <TextBlock Text="player" Style="{StaticResource MetroSubheaderStyle}" />
                <TextBlock Style="{StaticResource MetroBodyStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                           Text="Music goes to Music\Artist\Album with a cover.jpg, playlists to Playlists." />
                <TextBox x:Name="PlayerBox" Header="Player or SD card" PlaceholderText="D:\" />
                <Button Content="browse" Click="BrowsePlayer_Click" HorizontalAlignment="Left" />
                <CheckBox x:Name="DeleteBox" Margin="0,8,0,0"
                          Content="Delete downloads once they're verified on the player" />
                <TextBlock Style="{StaticResource MetroBodyStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="13"
                           Text="Only files this app copied, and checked byte for byte, are deleted from the download folder." />
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
