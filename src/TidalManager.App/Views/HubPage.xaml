<Page
    x:Class="TidalManager.App.Views.HubPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:TidalManager.App"
    NavigationCacheMode="Required"
    Background="{StaticResource MetroPageBrush}">
    <Page.Resources>
        <DataTemplate x:Key="TileTemplate" x:DataType="local:TileItem">
            <Button Style="{StaticResource MetroTileButtonStyle}" Click="Tile_Click" Tag="{x:Bind}"
                    AutomationProperties.Name="{x:Bind Title}">
                <Grid Width="190" Height="190" Background="{StaticResource MetroTilePlaceholderBrush}">
                    <TextBlock Text="&#xE8D6;" FontFamily="{StaticResource MetroGlyphFont}" FontSize="48" Opacity="0.25"
                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                    <Image Source="{x:Bind Image}" Stretch="UniformToFill" />
                    <StackPanel VerticalAlignment="Bottom" Background="#B3000000" Padding="10,6,10,8">
                        <TextBlock Text="{x:Bind Title}" FontFamily="{StaticResource MetroFont}" FontSize="15"
                                   Foreground="White" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                        <TextBlock Text="{x:Bind Subtitle}" FontFamily="{StaticResource MetroFont}" FontSize="12"
                                   Foreground="White" Opacity="0.7" TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                    <Grid Visibility="{x:Bind CheckVisibility, Mode=OneWay}">
                        <Border BorderBrush="{StaticResource MetroAccentBrush}" BorderThickness="4" />
                        <Polygon Points="0,0 40,0 40,40" Fill="{StaticResource MetroAccentBrush}"
                                 HorizontalAlignment="Right" VerticalAlignment="Top" />
                        <TextBlock Text="&#xE73E;" FontFamily="{StaticResource MetroGlyphFont}" FontSize="13"
                                   Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}"
                                   HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,5,5,0" />
                    </Grid>
                </Grid>
            </Button>
        </DataTemplate>
        <ItemsPanelTemplate x:Key="TilePanel">
            <VariableSizedWrapGrid Orientation="Vertical" ItemWidth="200" ItemHeight="200" />
        </ItemsPanelTemplate>
    </Page.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="140" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid Padding="120,0,40,30" ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="tidal manager" Style="{StaticResource MetroPageHeaderStyle}" VerticalAlignment="Bottom" />
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Bottom" Margin="0,0,0,12">
                <TextBox x:Name="SearchBox" Width="280" Height="38" PlaceholderText="search albums"
                         FontSize="15" KeyDown="SearchBox_KeyDown" />
                <Button Width="38" Height="38" MinWidth="0" MinHeight="0" Padding="0" Margin="0" BorderThickness="0"
                        Background="{StaticResource MetroAccentBrush}" Click="Search_Click" AutomationProperties.Name="Search">
                    <TextBlock Text="&#xE721;" FontFamily="{StaticResource MetroGlyphFont}" FontSize="16"
                               Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}" />
                </Button>
            </StackPanel>
            <Button Grid.Column="2" Style="{StaticResource MetroAppBarButtonStyle}" Tag="&#xE713;" Content="settings"
                    Width="80" VerticalAlignment="Bottom" Click="Settings_Click" />
        </Grid>

        <ScrollViewer Grid.Row="1" HorizontalScrollMode="Enabled" HorizontalScrollBarVisibility="Auto"
                      VerticalScrollMode="Disabled" VerticalScrollBarVisibility="Disabled" ZoomMode="Disabled">
            <StackPanel Orientation="Horizontal" Padding="120,0,80,40" Spacing="80">
                <StackPanel.ChildrenTransitions>
                    <TransitionCollection>
                        <EntranceThemeTransition IsStaggeringEnabled="True" FromHorizontalOffset="200" />
                    </TransitionCollection>
                </StackPanel.ChildrenTransitions>

                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <TextBlock Text="playlists" Style="{StaticResource MetroSectionHeaderStyle}" />
                    <ItemsControl x:Name="PlaylistTiles" Grid.Row="1" ItemTemplate="{StaticResource TileTemplate}"
                                  ItemsPanel="{StaticResource TilePanel}">
                        <ItemsControl.ItemContainerTransitions>
                            <TransitionCollection>
                                <EntranceThemeTransition IsStaggeringEnabled="True" />
                            </TransitionCollection>
                        </ItemsControl.ItemContainerTransitions>
                    </ItemsControl>
                    <StackPanel x:Name="PlaylistMessage" Grid.Row="1" Width="390" Spacing="16" Visibility="Collapsed">
                        <TextBlock x:Name="PlaylistMessageText" Style="{StaticResource MetroBodyStyle}" FontSize="20" FontWeight="Light" />
                        <Button x:Name="PlaylistMessageButton" Content="sign in" Click="Settings_Click" HorizontalAlignment="Left" />
                    </StackPanel>
                    <ProgressBar x:Name="PlaylistLoading" Grid.Row="1" Width="200" IsIndeterminate="True"
                                 VerticalAlignment="Top" HorizontalAlignment="Left" Visibility="Collapsed" />
                </Grid>

                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="albums" Style="{StaticResource MetroSectionHeaderStyle}" />
                    <Button Grid.Row="1" Style="{StaticResource MetroTileButtonStyle}" VerticalAlignment="Top"
                            Click="FindAlbums_Click" AutomationProperties.Name="Find albums">
                        <Grid Width="190" Height="190" Background="{StaticResource MetroAccentBrush}">
                            <TextBlock Text="&#xE721;" FontFamily="{StaticResource MetroGlyphFont}" FontSize="48"
                                       Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                            <TextBlock Text="find albums" FontFamily="{StaticResource MetroFont}" FontSize="15"
                                       Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}"
                                       FontWeight="SemiBold" Margin="10,0,10,10" VerticalAlignment="Bottom" />
                        </Grid>
                    </Button>
                    <ItemsControl x:Name="AlbumTiles" Grid.Row="1" Grid.Column="1" ItemTemplate="{StaticResource TileTemplate}"
                                  ItemsPanel="{StaticResource TilePanel}" Margin="10,0,0,0" />
                </Grid>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
