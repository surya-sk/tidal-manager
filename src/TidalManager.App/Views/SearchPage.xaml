<Page
    x:Class="TidalManager.App.Views.SearchPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:TidalManager.App"
    Background="{StaticResource MetroPageBrush}">
    <Page.Resources>
        <DataTemplate x:Key="TileTemplate" x:DataType="local:TileItem">
            <Button Style="{StaticResource MetroTileButtonStyle}" Click="Tile_Click" Tag="{x:Bind}"
                    AutomationProperties.Name="{x:Bind Title}">
                <Grid Width="190" Height="190" Background="{StaticResource MetroTilePlaceholderBrush}">
                    <TextBlock Text="&#xE93C;" FontFamily="{StaticResource MetroGlyphFont}" FontSize="48" Opacity="0.25"
                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                    <Image Source="{x:Bind Image}" Stretch="UniformToFill" />
                    <StackPanel VerticalAlignment="Bottom" Background="#B3000000" Padding="10,6,10,8">
                        <TextBlock Text="{x:Bind Title}" FontFamily="{StaticResource MetroFont}" FontSize="15"
                                   Foreground="White" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                        <TextBlock Text="{x:Bind Subtitle}" FontFamily="{StaticResource MetroFont}" FontSize="12"
                                   Foreground="White" Opacity="0.7" TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                    <Grid Visibility="{x:Bind CheckVisibility, Mode=OneWay}">
                        <Border BorderBrush="{StaticResource MetroAccentBrush}" BorderThickness="4" />
                        <Polygon Points="0,0 40,0 40,40" Fill="{StaticResource MetroAccentBrush}"
                                 HorizontalAlignment="Right" VerticalAlignment="Top" />
                        <TextBlock Text="&#xE73E;" FontFamily="{StaticResource MetroGlyphFont}" FontSize="13"
                                   Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}"
                                   HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,5,5,0" />
                    </Grid>
                </Grid>
            </Button>
        </DataTemplate>
    </Page.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="140" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid Padding="36,0,40,30">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="84" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Button Style="{StaticResource MetroBackButtonStyle}" VerticalAlignment="Bottom" Margin="0,0,0,2"
                    Content="" Click="Back_Click" />
            <TextBlock x:Name="Heading" Grid.Column="1" Style="{StaticResource MetroPageHeaderStyle}" VerticalAlignment="Bottom" />
            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Bottom" Margin="12,0,0,12">
                <TextBox x:Name="SearchBox" Width="280" Height="38" PlaceholderText="search albums"
                         FontSize="15" KeyDown="SearchBox_KeyDown" />
                <Button Width="38" Height="38" MinWidth="0" MinHeight="0" Padding="0" Margin="0" BorderThickness="0"
                        Background="{StaticResource MetroAccentBrush}" Click="Search_Click" AutomationProperties.Name="Search">
                    <TextBlock Text="&#xE721;" FontFamily="{StaticResource MetroGlyphFont}" FontSize="16"
                               Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}" />
                </Button>
            </StackPanel>
        </Grid>
        <TextBlock x:Name="Hint" Grid.Row="1" Margin="120,0,40,20" Style="{StaticResource MetroBodyStyle}"
                   Foreground="{StaticResource MetroDimTextBrush}" Text="Tap albums to put them on your player." />
        <ProgressBar x:Name="LoadingBar" Grid.Row="2" Margin="120,0,0,0" Width="200" IsIndeterminate="True"
                     VerticalAlignment="Top" HorizontalAlignment="Left" />
        <ScrollViewer Grid.Row="2" HorizontalScrollMode="Enabled" HorizontalScrollBarVisibility="Auto"
                      VerticalScrollMode="Disabled" VerticalScrollBarVisibility="Disabled" ZoomMode="Disabled">
            <ItemsControl x:Name="Results" Margin="120,0,80,40" ItemTemplate="{StaticResource TileTemplate}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <VariableSizedWrapGrid Orientation="Vertical" ItemWidth="200" ItemHeight="200" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemContainerTransitions>
                    <TransitionCollection>
                        <EntranceThemeTransition IsStaggeringEnabled="True" FromHorizontalOffset="120" />
                    </TransitionCollection>
                </ItemsControl.ItemContainerTransitions>
            </ItemsControl>
        </ScrollViewer>
    </Grid>
</Page>
